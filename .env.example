# ---------------------------------------------------------------------------
# Glassboard configuration
# Copy this file to .env and adjust. Never commit your own .env.
# ---------------------------------------------------------------------------

# Secret used to sign sessions and encrypt stored integration credentials.
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=replace-me-with-a-long-random-string

# HTTP server
PORT=3000
HOST=127.0.0.1

# Where user data lives (SQLite database, backups, tile cache).
# Must be a writable directory outside the source tree.
DATA_DIR=./data

# Set to 1 when Glassboard runs behind a reverse proxy (nginx, Traefik, ...)
# so that client IPs and the HTTPS flag are read from X-Forwarded-* headers.
TRUST_PROXY=0

# Session cookie: auto | true | false
# "auto" marks the cookie Secure only when the request arrives over HTTPS.
COOKIE_SECURE=auto

# Session lifetime, in hours.
SESSION_TTL_HOURS=720

# Failed logins allowed per account/IP before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Optional: contact address sent to OpenStreetMap services, as their usage
# policy requests. Leave empty to send a generic identifier.
OSM_CONTACT=
